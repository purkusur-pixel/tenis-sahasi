[Unit]
Description=Tenis Oyuncu Takibi (staj5.2)
# Ag hazir olmadan baslarsa MJPEG yayini ve telefon kurulum sayfasi
# dogru adrese baglanamaz -> once ag beklenir.
After=network-online.target NetworkManager.service
Wants=network-online.target
# Kamera henuz takili degilse servis duser ve tekrar dener. Bu NORMAL:
# kamera baglanir baglanmaz kendiliginden calismaya baslar. systemd'nin
# "cok sik basarisiz oldu, pes ediyorum" davranisini kapatiyoruz.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
# Kamera (video) ve GPU (render) erisimi icin.
SupplementaryGroups=video render
WorkingDirectory=/home/pi/staj5.2
# -u : cikti tamponlanmasin, journalctl'de aninda gorunsun.
ExecStart=/home/pi/staj5.2/venv/bin/python -u /home/pi/staj5.2/main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
